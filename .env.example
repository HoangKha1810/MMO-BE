DATABASE_URL="mysql://root:@localhost:3306/htbmmo"
NODE_ENV=development

# Security
ENCRYPTION_KEY=your-32-char-secret-key-here
NEXTAUTH_SECRET=your-nextauth-secret-key

# Mail alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
ADMIN_ALERT_FROM_EMAIL=
ADMIN_ALERT_RECIPIENTS=
SECURITY_ALERT_RECIPIENTS=

# Cloudflare Turnstile
TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key

# External APIs
GAME_API_PROXY_TARGET="https://trungtammmo.vn"
TELEGRAM_BOT_TOKEN=
MOMO_API_KEY=
SEPAY_API_KEY=
SMM_API_URL="https://submetavip.com/api/v2"
SMM_API_KEY=
SMM_API_EXCHANGE_RATE=26000
SMM_API_MARGIN_PERCENT=0
SMM_API_IS_PER_UNIT=0

# Integrated VPS portal
# VPS module also falls back to DB_HOST/DB_USER/DB_PASS/DB_NAME when MYSQL_* is empty.
INTEGRATED_VPS_JWT_SECRET=change-this-vps-jwt-secret
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=trungt35_database2
MYSQL_CONNECTION_LIMIT=10
PUBLIC_ASSET_BASE_URL=https://trungtammmo.vn
VNCLOUD_BASE_URL=https://portal.vncloud.net
VNCLOUD_API_USERNAME=
VNCLOUD_API_PASSWORD=
VNCLOUD_API_TOKEN=
VNCLOUD_TOKEN_TIMEZONE=Asia/Ho_Chi_Minh
VNCLOUD_TOKEN_ROTATION_HOURS=2,14
